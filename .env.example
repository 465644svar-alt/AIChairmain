# AIChairmain — Environment Variables
# Copy this file to .env and fill in your API keys.

# At least one provider key is required.
# Models using a provider without a key will return errors.

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AI...
GROQ_API_KEY=gsk_...
MISTRAL_API_KEY=...

# Server settings (optional)
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:5173
